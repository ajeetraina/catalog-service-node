# API Configuration
PORT=3001

# Database Configuration (IMPORTANT: Use container service names, not localhost)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=catalog

# Database URL for connection (alternative format)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/catalog

# Legacy environment variables (some services might use these)
PGHOST=postgres
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=catalog

# AWS Configuration for LocalStack (container environment)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://aws:4566
INVENTORY_SERVICE_BASE_URL=http://mock-inventory:8080

# Model Runner Configuration (connects to host Model Runner via Docker Desktop)
BASE_URL=http://host.docker.internal:12434/engines/llama.cpp/v1/
MODEL=ai/llama3.2:1B-Q8_0
API_KEY=${API_KEY:-dockermodelrunner}

# Observability configuration
LOG_LEVEL=info
LOG_PRETTY=true
TRACING_ENABLED=false

# Node.js Environment
NODE_ENV=development
