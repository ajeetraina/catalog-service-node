# API Configuration
PORT=3001
NODE_ENV=development

# Database Configuration (Container networking)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=catalog

# Database URL for connection
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/catalog

# Legacy environment variables
PGHOST=postgres
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=catalog

# AWS/S3 Configuration (LocalStack)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://aws:4566
S3_BUCKET=product-images

# External Services (Container networking)
INVENTORY_SERVICE_BASE_URL=http://mock-inventory:8080

# Kafka Configuration (Container networking)
KAFKA_BROKERS=kafka:9093
KAFKA_CLIENT_ID=catalog-api
KAFKA_GROUP_ID=catalog-api-group

# Model Runner Configuration (New Docker Compose model integration)
OPENAI_API_URL=http://llama_model:8080/v1
OPENAI_BASE_URL=http://llama_model:8080/v1
OPENAI_API_KEY=dockermodelrunner
OPENAI_MODEL=ai/llama3.2:latest
MODEL=ai/llama3.2:latest
LLM_MODEL_NAME=ai/llama3.2:latest

# Monitoring and Observability
LOG_LEVEL=info
LOG_PRETTY=true
TRACING_ENABLED=true
JAEGER_ENDPOINT=http://jaeger:4318/v1/traces
PROMETHEUS_METRICS_PORT=9090

# Application Features
ENABLE_CHAT=true
ENABLE_AI_PRODUCT_GENERATION=true
ENABLE_METRICS=true

# Base URL for model runner (required by application code)
BASE_URL=http://host.docker.internal:12434/engines/llama.cpp/v1
