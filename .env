AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566 
INVENTORY_SERVICE_BASE_URL=http://localhost:8090

# Note: PostgreSQL connection settings are now in catalog-api.env
